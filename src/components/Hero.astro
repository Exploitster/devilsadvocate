---
import UserLine from './UserLine.astro';
import ProductLine from './ProductLine.astro';
import Receipt from './Receipt.astro';
import { SECTIONS, WAITLIST_ON } from '../config';
---

<section id={SECTIONS.hero} aria-labelledby="hero-heading" class="hero container-page">
  <div class="hero__grid">
    <div class="hero__copy">
      <h1 id="hero-heading" class="hero__headline">
        <span class="hero__sentence">Your idea sounds great.</span>{' '}
        <span class="hero__sentence">That’s what worries us.</span>
      </h1>

      <p class="hero__subhead">
        Type out your startup idea or big decision. Devils Advocate asks the awkward questions, brings receipts from
        failed startups and 2,000 years of philosophy, then hands the decision back to you. You’re the boss. We just read
        the fine print.
      </p>

      <div class="hero__actions">
        {
          WAITLIST_ON ? (
            <>
              <a href={`#${SECTIONS.waitlist}`} class="btn-primary">
                Join the waitlist
              </a>
              <a href={`#${SECTIONS.howItWorks}`} class="link-quiet link-more inline-flex min-h-11 items-center">
                See how it works
              </a>
            </>
          ) : (
            <a href={`#${SECTIONS.howItWorks}`} class="btn-primary">
              See how it works
            </a>
          )
        }
      </div>

      <p class="hero__smallprint">
        Private beta opens <time datetime="2026-12-01">December 1, 2026</time>.{
          WAITLIST_ON && ' No spam. We save the arguing for the product.'
        }
      </p>
    </div>

    {/*
      The debate is a scripted illustration. Its markup is the finished
      conversation, which is what shows with JavaScript off or with reduced
      motion. debate.ts hides the turns and plays them in once.
    */}
    <figure class="debate" data-debate aria-labelledby="debate-caption" tabindex="-1">
      <div class="debate__turns bubbles">
        <UserLine size="lg" bodyAs="div" class="turn turn--user" data-turn>
          <p class="turn__text" data-type-out>I’m building food delivery for college hostels. The big apps made it, so will I.</p>
        </UserLine>

        <ProductLine size="lg" bodyAs="div" class="turn turn--product" data-turn>
          <span class="typing" aria-hidden="true"><span></span><span></span><span></span></span>
          <p class="turn__text">Love the confidence. Quick question first: who’s paying? The students, or their parents’ wallets?</p>
        </ProductLine>

        <ProductLine size="lg" bodyAs="div" class="turn turn--product" data-turn>
          <span class="typing" aria-hidden="true"><span></span><span></span><span></span></span>
          <p class="turn__text">
            Also, the big apps are the survivors. We found three hostel-delivery startups that didn’t make it. Want to meet them?
          </p>
          <p class="turn__receipt"><Receipt>3 similar startups, why they shut down, sources linked</Receipt></p>
        </ProductLine>

        <ProductLine size="lg" bodyAs="div" class="turn turn--product" data-turn>
          <span class="typing" aria-hidden="true"><span></span><span></span><span></span></span>
          <p class="turn__text">Your call. Always.</p>
        </ProductLine>
      </div>

      <div class="debate__footer">
        <figcaption id="debate-caption" class="debate__caption">An illustration of a sample conversation.</figcaption>
        <button type="button" class="debate__replay link-quiet" data-replay hidden>Replay</button>
      </div>
    </figure>
    <script is:inline>
      // Arm the animation before first paint so the finished conversation
      // never flashes. If debate.ts hasn't taken over within 4s (blocked or
      // failed), disarm so the conversation is never left invisible.
      (function () {
        var el = document.querySelector('[data-debate]');
        if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        el.setAttribute('data-state', 'armed');
        setTimeout(function () {
          if (!el.hasAttribute('data-controlled')) el.removeAttribute('data-state');
        }, 4000);
      })();
    </script>
  </div>
</section>

<script>
  import { initDebate } from '../scripts/debate';
  initDebate();
</script>

<style is:global>
  /* ---------------------------------------------------------------- */
  /* Layout: centered on phones; copy left, chat right on desktop.     */
  /* ---------------------------------------------------------------- */

  .hero {
    padding-top: clamp(2.5rem, 1rem + 5vw, 5.5rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  .hero__grid {
    display: grid;
    gap: 2.75rem;
  }

  .hero__copy {
    text-align: center;
  }

  /* Desktop: compact enough that the capsule under the hero is on screen
     from the start on a laptop. */
  @media (min-width: 64rem) {
    .hero {
      padding-top: 3.5rem;
      padding-bottom: 3rem;
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 25rem);
      column-gap: clamp(2.5rem, 4vw, 4rem);
      align-items: center;
    }
    .hero__copy {
      text-align: left;
    }
  }

  /* Each sentence on its own line(s): the setup, then the turn. */
  .hero__headline {
    font-size: var(--step-display);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .hero__sentence {
    display: block;
  }
  /* Sized so each sentence stays on one line beside the chat. */
  @media (min-width: 64rem) {
    .hero__headline {
      font-size: clamp(2.75rem, 0.375rem + 3.9vw, 3.5rem);
    }
  }

  .hero__subhead {
    margin: 1.25rem auto 0;
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem;
  }

  .hero__smallprint {
    margin: 1rem auto 0;
    max-width: 30rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  @media (min-width: 64rem) {
    .hero__subhead,
    .hero__smallprint {
      margin-inline: 0;
    }
    .hero__subhead {
      font-size: 1.25rem;
    }
    .hero__actions {
      justify-content: flex-start;
    }
  }

  /* ---------------------------------------------------------------- */
  /* The debate: a chat on a white tile                                */
  /* ---------------------------------------------------------------- */

  .debate {
    width: 100%;
    max-width: 30rem;
    margin: 0 auto;
    padding: 1.25rem 1rem 0.5rem;
    border-radius: var(--r-tile);
    background: var(--surface);
    box-shadow: var(--shadow-lift);
  }
  .debate:focus {
    outline: none;
  }
  @media (min-width: 48rem) {
    .debate {
      padding: 1.5rem 1.5rem 0.75rem;
    }
  }

  .debate__turns {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    font-size: 1rem;
    line-height: 1.4;
  }
  .debate__turns .line--lg {
    font-size: inherit;
    line-height: inherit;
  }

  .debate .line__body {
    position: relative;
  }

  .turn__receipt {
    margin-top: 0.5rem;
  }

  .debate__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    min-height: 2.75rem;
    margin-top: 0.75rem;
    padding-top: 0.25rem;
    box-shadow: inset 0 1px 0 var(--line);
  }

  .debate__caption {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .debate__replay {
    min-height: 2.75rem;
    padding: 0 0.25rem;
    font-size: var(--step--1);
    cursor: pointer;
  }

  /* The typing dots exist only while the animation runs. In the finished
     (default) state they are not shown at all. */
  .typing {
    display: none;
  }

  /* ---------------------------------------------------------------- */
  /* Animation states. Only reachable once debate.ts has armed the     */
  /* debate, which it never does under prefers-reduced-motion.         */
  /* ---------------------------------------------------------------- */

  .debate[data-state] .turn {
    transition:
      opacity 280ms ease-out,
      transform 280ms var(--ease);
  }
  .debate[data-state] .turn:not([data-step]),
  .debate[data-state] .turn[data-step='hidden'] {
    opacity: 0;
    transform: translateY(0.375rem);
  }

  /* Hidden parts still take up their space, so nothing below jumps. The
     bubble itself fills in when its words arrive. */
  .debate[data-state] .line__body {
    transition: background-color 240ms ease;
  }
  .debate[data-state] .turn__text,
  .debate[data-state] .turn__receipt {
    transition: opacity 320ms ease-out;
  }
  .debate[data-state] .turn:not([data-step='shown']):not([data-step='composing']) :is(.turn__text, .turn__receipt) {
    opacity: 0;
  }
  .debate[data-state] .turn--product:not([data-step='shown']) .line__body {
    background-color: transparent;
  }

  /* 1. The user's message types itself out in an outlined draft bubble
        behind a blinking cursor, then fills in as it's sent. debate.ts
        splits it into per-character spans; characters not yet typed are
        invisible but keep their space, so lines never re-wrap. */
  .debate[data-state] .turn--user:not([data-step='shown']) .line__body {
    background-color: transparent;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .typed__char {
    position: relative;
  }
  .debate[data-state] .turn--user:not([data-step='shown']) .typed__char:not(.is-typed) {
    visibility: hidden;
  }
  .typed__char.is-caret::after {
    content: '';
    position: absolute;
    top: 0.12em;
    right: -0.09em;
    width: 2px;
    height: 1.1em;
    border-radius: 1px;
    background: var(--accent);
    animation: caret 1s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  /* 2. Replies: a small grey bubble with typing dots, then the words. */
  .typing {
    position: absolute;
    top: 0;
    left: 0;
    gap: 0.3rem;
    align-items: center;
    height: 2.1em;
    padding: 0 0.85em;
    border-radius: 1.15em;
    border-bottom-left-radius: 0.35em;
    background: var(--bubble-product-bg);
  }
  .debate[data-state] .turn[data-step='typing'] .typing {
    display: flex;
  }
  .typing span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ink-2);
    animation: typing 900ms ease-in-out infinite;
  }
  .typing span:nth-child(2) {
    animation-delay: 150ms;
  }
  .typing span:nth-child(3) {
    animation-delay: 300ms;
  }
  @keyframes typing {
    0%,
    60%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
      transform: translateY(-0.2rem);
    }
  }

  /* 3. The receipt is highlighted in, like a marker pass, just after
        its line lands. */
  .debate[data-state] .receipt {
    background-color: transparent;
    background-image: linear-gradient(var(--evidence), var(--evidence));
    background-repeat: no-repeat;
    background-size: 0% 100%;
    transition: background-size 520ms cubic-bezier(0.3, 0.7, 0.3, 1) 380ms;
  }
  .debate[data-state] .turn[data-step='shown'] .receipt {
    background-size: 100% 100%;
  }
</style>
