---
/**
 * "Try a sample debate": pre-written debates, three per category, that
 * the reader plays by tapping answers. There's no text input: at every
 * step sample.ts offers a few chips, and each chip has its own scripted
 * reply (the decision tree lives in src/data/samples.ts). The hand-back
 * card beside the chat fills in from the answers picked.
 *
 * Without JavaScript the page shows one finished path through each
 * debate (the first answer at every step) and its finished card.
 */
import UserLine from './UserLine.astro';
import ProductLine from './ProductLine.astro';
import Receipt from './Receipt.astro';
import { CATEGORIES, CATEGORY } from '../data/categories';
import { GREETING, NEXT, SAMPLES, STAGES } from '../data/samples';
import { SECTIONS, WAITLIST_ON } from '../config';

const NOTE = {
  startup: 'Samples use made-up startups, labeled as illustrative. The real thing cites sources.',
  philosophy: 'The sources are real; the lines are paraphrases, not quotes. The conversation is a sample.',
};
const DONE_LINE = 'Here’s your hand-back card. No verdict. Your call, always.';
const PUSH_LINE = 'Your turn. Push back on any of it.';

// What the script needs, per panel. `<` is escaped so the JSON can't end
// the <script> element early.
const payload = (cat: (typeof CATEGORIES)[number], k: number) =>
  JSON.stringify({
    greeting: GREETING[cat],
    next: NEXT,
    done: DONE_LINE,
    push: PUSH_LINE,
    sample: SAMPLES[cat][k],
  }).replace(/</g, '\\u003c');
---

<section id={SECTIONS.trySample} aria-labelledby="try-heading" class="section container-page">
  <div class="try-head section-head">
    <h2 id="try-heading">Try a sample debate</h2>
    <ProductLine size="lg" class="section-lead">
      Pick a sample, then tap your answers and watch it argue back. Every reply is written in advance, so there’s nothing
      to type. The real thing argues with whatever you bring.
    </ProductLine>
  </div>

  {
    CATEGORIES.map((cat) => (
      <div class="try" data-try data-cat={cat}>
        <div class="try__tabs" role="tablist" aria-label={`${CATEGORY[cat].label} samples`} data-sample-tabs>
          {SAMPLES[cat].map((s, k) => (
            <button
              type="button"
              role="tab"
              class="try__tab"
              id={`sample-tab-${s.id}`}
              aria-controls={`sample-${s.id}`}
              aria-selected={k === 0 ? 'true' : 'false'}
              tabindex={k === 0 ? 0 : -1}
              data-sample-tab={k}
            >
              <span class="try__tab-title">{s.tab}</span>
              <span class="try__tab-kind">{s.kind}</span>
            </button>
          ))}
        </div>

        {SAMPLES[cat].map((s, k) => {
          // The path shown without JavaScript: the first answer each time.
          const answers = s.questions.map((q) => q.choices[0]!);
          const push = s.pushbacks[0]!;
          return (
            <div
              class="try__panel"
              role="tabpanel"
              id={`sample-${s.id}`}
              aria-labelledby={`sample-tab-${s.id}`}
              data-sample={k}
              hidden={k !== 0}
            >
              <script type="application/json" data-sample-json set:html={payload(cat, k)} />
              <div class="try__grid">
                <div class="chat">
                  <div class="chat__bar">
                    <div>
                      <p class="chat__title">Devils Advocate</p>
                      <p class="chat__mode">{CATEGORY[cat].mode}</p>
                    </div>
                    <button type="button" class="chat__restart" data-restart>
                      {NEXT.restart}
                    </button>
                  </div>

                  <div class="chat__stages">
                    <ol class="stages" role="list" aria-label="Where the debate is">
                      {STAGES[cat].map((label, n) => (
                        <li class="stage" data-stage-n={n}>
                          <span class="stage__num" aria-hidden="true">
                            {n + 1}
                          </span>
                          <span class="stage__label">{label}</span>
                        </li>
                      ))}
                    </ol>
                  </div>

                  <ol class="chat__log bubbles" role="list" tabindex="0" aria-label="Sample conversation" data-log>
                    <li class="msg">
                      <div class="msg__in">
                        <ProductLine size="sm">{GREETING[cat]}</ProductLine>
                      </div>
                    </li>
                    <li class="msg">
                      <div class="msg__in">
                        <UserLine size="sm">{s.opening}</UserLine>
                      </div>
                    </li>
                    {s.questions.map((q, n) => (
                      <>
                        <li class="msg">
                          <div class="msg__in">
                            <ProductLine size="sm">{q.q}</ProductLine>
                          </div>
                        </li>
                        <li class="msg">
                          <div class="msg__in">
                            <UserLine size="sm">{answers[n]!.say}</UserLine>
                          </div>
                        </li>
                        <li class="msg">
                          <div class="msg__in">
                            <ProductLine size="sm">{answers[n]!.reply}</ProductLine>
                          </div>
                        </li>
                      </>
                    ))}
                    <li class="msg">
                      <div class="msg__in">
                        <ProductLine size="sm" bodyAs="div">
                          <p>
                            <strong class="lead">The real question:</strong> {s.realQuestion}
                          </p>
                          {s.bias && (
                            <p>
                              <strong class="lead">Bias spotted:</strong> {s.bias}
                            </p>
                          )}
                        </ProductLine>
                      </div>
                    </li>
                    <li class="msg">
                      <div class="msg__in">
                        <ProductLine size="sm" bodyAs="div">
                          <p class="lead">What’s genuinely strong in your case:</p>
                          <ul class="points" role="list">
                            {s.caseFor.map((c) => (
                              <li>
                                {c.text}
                                {c.source && (
                                  <>
                                    {' '}
                                    <Receipt>{c.source}</Receipt>
                                  </>
                                )}
                              </li>
                            ))}
                          </ul>
                        </ProductLine>
                      </div>
                    </li>
                    <li class="msg">
                      <div class="msg__in">
                        <ProductLine size="sm" bodyAs="div">
                          <p class="lead">The strongest other side:</p>
                          <ul class="points points--receipts" role="list">
                            {s.otherSide.map((r) => (
                              <li>
                                <Receipt>{r.source}</Receipt>
                                <span class="points__text">{r.point}</span>
                              </li>
                            ))}
                          </ul>
                          <p class="msg__note">{s.note}</p>
                        </ProductLine>
                      </div>
                    </li>
                    <li class="msg">
                      <div class="msg__in">
                        <UserLine size="sm">{push.say}</UserLine>
                      </div>
                    </li>
                    <li class="msg">
                      <div class="msg__in">
                        <ProductLine size="sm">{push.reply}</ProductLine>
                      </div>
                    </li>
                    <li class="msg">
                      <div class="msg__in">
                        <ProductLine size="sm">{DONE_LINE}</ProductLine>
                      </div>
                    </li>
                  </ol>

                  {/* Your side of the chat: the answers you can tap. */}
                  <div class="chat__replies" role="group" aria-label="Your reply" data-replies>
                    {/* The first chip, already in place so nothing shifts when
                        sample.ts takes over (it replaces this with a live one). */}
                    <button type="button" class="reply-chip">
                      {s.opening}
                    </button>
                  </div>
                </div>

                <article class="try-card" aria-labelledby={`sample-card-${s.id}`}>
                  <header class="try-card__head">
                    <p class="try-card__title" id={`sample-card-${s.id}`}>
                      Hand-back card
                    </p>
                    <p class="try-card__fills" data-fills>
                      Fills in from your answers
                    </p>
                  </header>

                  <div class="part" data-part="position">
                    <h3 class="part__label">Your position</h3>
                    <div class="part__slot">
                      <div class="part__value">
                        <UserLine size="sm" speaker={false}>
                          {s.card.position}
                        </UserLine>
                      </div>
                      <span class="part__wait" aria-hidden="true" />
                    </div>
                  </div>

                  <div class="part" data-part="strong">
                    <h3 class="part__label">What’s genuinely strong</h3>
                    <div class="part__slot">
                      <p class="part__value part__prose">{s.card.strong}</p>
                      <span class="part__wait" aria-hidden="true" />
                    </div>
                  </div>

                  <div class="part" data-part="counter">
                    <h3 class="part__label">Toughest counterpoints</h3>
                    <div class="part__slot">
                      <ul class="part__value part__chips" role="list">
                        {s.otherSide.map((r) => (
                          <li>
                            <Receipt>{r.source}</Receipt>
                          </li>
                        ))}
                      </ul>
                      <span class="part__wait" aria-hidden="true" />
                    </div>
                  </div>

                  <div class="part" data-part="open">
                    <h3 class="part__label">Open questions only you can answer</h3>
                    <div class="part__slot">
                      <ul class="part__value part__list" role="list" data-open>
                        {answers.map((a) => (
                          <li>{a.open}</li>
                        ))}
                      </ul>
                      <span class="part__wait" aria-hidden="true" />
                    </div>
                  </div>

                  <div class="part" data-part="test">
                    <h3 class="part__label">Cheapest test this month</h3>
                    <div class="part__slot">
                      <p class="part__value part__prose" data-test>
                        {push.test}
                      </p>
                      <span class="part__wait" aria-hidden="true" />
                    </div>
                  </div>
                </article>
              </div>

            </div>
          );
        })}

        <p class="try__note">{NOTE[cat]}</p>

        {WAITLIST_ON && (
          <div class="try__cta">
            <ProductLine size="lg" speaker={false}>
              Want it to argue with your own {CATEGORY[cat].noun}?
            </ProductLine>
            <a href={`#${SECTIONS.waitlist}`} class="btn-primary">
              Join the waitlist
            </a>
          </div>
        )}
      </div>
    ))
  }
</section>

<script>
  import { initSamples } from '../scripts/sample';
  initSamples();
</script>

<style is:global>
  .try {
    margin-top: 2.5rem;
  }

  /* Sample tabs: a real tablist, as a row of pills. */
  .try__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  /* The sample tabs, the reply chips and Start over need JavaScript;
     without it you get the first sample, finished. */
  html:not(.js) .try__tabs,
  html:not(.js) .chat__replies,
  html:not(.js) .chat__restart,
  html:not(.js) .try-card__fills,
  .try-card__fills[hidden] {
    display: none;
  }
  .try__tab {
    flex: none;
    display: grid;
    min-height: 3.25rem;
    padding: 0.5rem 1.25rem;
    border-radius: 1.125rem;
    background: var(--surface);
    text-align: left;
    line-height: 1.25;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      box-shadow 200ms ease;
  }
  .try__tab:hover {
    background: var(--surface-2);
  }
  .try__tab[aria-selected='true'] {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }
  .try__tab-title {
    font-weight: 600;
  }
  /* Phones: one full-width row per sample, so the names never jostle. */
  @media (max-width: 39.999rem) {
    .try__tabs {
      display: grid;
    }
  }
  .try__tab-kind {
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .try__grid {
    display: grid;
    gap: 1rem;
  }
  /* Desktop: chat and card side by side, the same height. */
  @media (min-width: 64rem) {
    .try__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 1.25rem;
    }
    .try__grid .chat__log {
      flex: 1 1 0;
      height: auto;
      min-height: 26rem;
    }
  }

  /* The chat window: a white tile. */
  .chat {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-tile);
    background: var(--surface);
  }
  .chat__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1rem 0.75rem 1.25rem;
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .chat__title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .chat__mode {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .chat__restart {
    flex: none;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: var(--r-pill);
    background: var(--surface-2);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 200ms ease;
  }
  .chat__restart:hover {
    background: var(--accent-soft);
  }

  /* Stages: they move on their own, and jump when pressed. */
  .chat__stages {
    padding: 0.625rem 0.75rem;
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .stages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .stage {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0 0.75rem 0 0.375rem;
    border-radius: var(--r-pill);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-2);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }
  .stage__label {
    white-space: nowrap;
  }
  .stage__num {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--surface-2);
    font-size: 0.75rem;
    transition: background-color 200ms ease;
  }
  .stage[data-state='done'] {
    color: var(--ink);
  }
  .stage[data-state='done'] .stage__num {
    background: var(--accent-soft);
  }
  .stage[aria-current='step'] {
    background: var(--accent);
    color: var(--on-accent);
  }
  .stage[aria-current='step'] .stage__num {
    background: transparent;
  }

  /* Phones: numbers only, except the stage it's on. */
  @media (max-width: 47.999rem) {
    .stages {
      flex-wrap: nowrap;
      justify-content: space-between;
    }
    /* Tighter on phones, so the step you're on fits on one line beside
       the other five numbers, even at 360px. */
    .stage {
      gap: 0.3125rem;
      min-height: 2.25rem;
      padding: 0 0.125rem;
      font-size: 0.8125rem;
    }
    .stage__num {
      width: 1.375rem;
      height: 1.375rem;
    }
    .stage:not([aria-current='step']) .stage__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .stage[aria-current='step'] {
      padding: 0 0.625rem 0 0.25rem;
    }
  }

  /* The conversation scrolls inside the window, newest at the bottom. */
  .chat__log {
    display: flex;
    flex-direction: column;
    height: clamp(18rem, 46svh, 26rem);
    padding: 0.25rem 1rem 1.25rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    font-size: 0.9375rem;
  }
  .chat__log:focus-visible {
    outline-offset: -3px;
  }
  .msg__in {
    padding-top: 0.5rem;
  }
  .msg .lead {
    font-weight: 600;
  }
  .points {
    display: grid;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }
  .points--receipts li {
    display: grid;
    justify-items: start;
    gap: 0.25rem;
  }
  .msg__note {
    margin-top: 0.625rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  /* Your replies: chips under the chat, on your side (the right). Each
     one is a scripted answer; tapping it says it. */
  .chat__replies {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-content: flex-end;
    gap: 0.5rem;
    min-height: 4.25rem;
    padding: 0.75rem 1rem 1rem;
    box-shadow: inset 0 1px 0 var(--line);
  }
  .reply-chip {
    max-width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border-radius: 1.375rem;
    background: var(--surface);
    box-shadow: inset 0 0 0 1.5px var(--accent);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      transform 160ms var(--ease);
  }
  .reply-chip:hover {
    background: var(--accent-soft);
  }
  .reply-chip:active {
    transform: scale(0.97);
  }
  /* Start over / Try another: controls, not something you say. */
  .reply-chip--quiet {
    box-shadow: inset 0 0 0 1px var(--control);
    color: var(--ink-2);
  }
  .chat__replies:focus {
    outline: none;
  }

  .chat-dots {
    display: inline-flex;
    gap: 0.3rem;
    align-items: center;
    height: 2.1em;
    padding: 0 0.85em;
    border-radius: 1.15em;
    border-bottom-left-radius: 0.35em;
    background: var(--bubble-product-bg);
  }
  .chat-dots span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ink-2);
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .msg[data-new] {
      animation: msg-in 320ms var(--ease) both;
    }
    .chat-dots span {
      animation: sample-bounce 900ms ease-in-out infinite;
    }
    .chat-dots span:nth-child(2) {
      animation-delay: 150ms;
    }
    .chat-dots span:nth-child(3) {
      animation-delay: 300ms;
    }
    .reply-chip[data-new] {
      animation: msg-in 260ms var(--ease) both;
    }
  }
  @keyframes msg-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }
  @keyframes sample-bounce {
    0%,
    100% {
      transform: none;
      opacity: 0.45;
    }
    40% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }

  /* The hand-back card that builds itself: a white tile, grouped like an
     inset list. */
  .try-card {
    overflow: hidden;
    border-radius: var(--r-tile);
    background: var(--surface);
  }
  .try-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 1.125rem 1.25rem 0.5rem;
  }
  .try-card__title {
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .try-card__fills {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .part {
    display: grid;
    gap: 0.375rem;
    padding: 0.875rem 1.25rem;
  }
  .part + .part {
    box-shadow: inset 0 1px 0 var(--line);
  }
  .part__label {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--ink-2);
  }
  .part__slot {
    display: grid;
  }
  .part__slot > * {
    grid-area: 1 / 1;
  }
  .part__prose {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.45;
  }
  .part__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .part__list {
    display: grid;
    gap: 0.25rem;
  }
  .part__list li {
    position: relative;
    padding-left: 1.125rem;
  }
  .part__list li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--ink-2);
  }
  .part__wait {
    display: none;
  }

  /* With JavaScript, each part waits as a placeholder until your answers
     get there, then fills. */
  html.js .try .part__value {
    opacity: 1;
    transition: opacity 360ms ease;
  }
  html.js .try .part:not([data-filled]) .part__value {
    opacity: 0;
  }
  html.js .try .part__wait {
    --bar: color-mix(in srgb, var(--ink) 8%, transparent);
    display: block;
    align-self: start;
    height: 2.5rem;
    border-radius: 0.375rem;
    background:
      linear-gradient(var(--bar), var(--bar)) 0 0.25rem / 85% 0.625rem no-repeat,
      linear-gradient(var(--bar), var(--bar)) 0 1.5rem / 55% 0.625rem no-repeat;
    transition: opacity 240ms ease;
  }
  html.js .try .part[data-filled] .part__wait {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .try .part__value,
    html.js .try .part__wait {
      transition: none;
    }
  }

  .try__note {
    max-width: var(--measure);
    margin: 1.25rem auto 0;
    font-size: var(--step--1);
    text-align: center;
    color: var(--ink-2);
  }

  .try__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    margin-top: 3rem;
    text-align: center;
  }
  .try__cta .line {
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
</style>
