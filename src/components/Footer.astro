---
import { WAITLIST_ON, path } from '../config';
---

<footer class="site-footer">
  <div class="container-page flex flex-col gap-3 py-8 sm:flex-row sm:items-center sm:justify-between">
    <p class="max-w-measure">
      Built by Avinash G, an MBA student who heard “great idea” one too many times.
    </p>
    {
      WAITLIST_ON && (
        <a href={path('/privacy/')} class="link-quiet inline-flex min-h-11 items-center">
          Privacy
        </a>
      )
    }
  </div>
</footer>

<style>
  .site-footer {
    box-shadow: inset 0 1px 0 var(--line);
    font-size: 0.875rem;
    color: var(--ink-2);
  }
</style>
