---
/**
 * What the chosen category does, specifically: the promise, the four
 * things it does, and what you can bring to it, as flat tiles. The heading
 * is shared (so the section keeps one name); only the word in it changes.
 */
import ProductLine from './ProductLine.astro';
import { CATEGORIES, CATEGORY, WHAT_IT_DOES } from '../data/categories';
import { SECTIONS } from '../config';
---

<section id={SECTIONS.whatItDoes} aria-labelledby="does-heading" class="section container-page">
  <div class="section-head">
    <h2 id="does-heading">
      What it does for your{' '}
      {CATEGORIES.map((cat) => <span data-cat={cat}>{CATEGORY[cat].noun}</span>)}
    </h2>
    {
      CATEGORIES.map((cat) => (
        <p class="does__mode" data-cat={cat}>
          The mode you’d pick: <span class="does__mode-name">{CATEGORY[cat].mode}</span>
        </p>
      ))
    }
  </div>

  {
    CATEGORIES.map((cat) => (
      <div class="does" data-cat={cat}>
        <div class="does__promise">
          <ProductLine size="lg">{WHAT_IT_DOES[cat].promise}</ProductLine>
        </div>

        <h3 class="does__sub">What it does, specifically</h3>
        <dl class="does__grid">
          {WHAT_IT_DOES[cat].does.map((item) => (
            <div class="tile does__tile">
              <dt class="does__what">{item.what}</dt>
              <dd class="does__how">{item.how}</dd>
            </div>
          ))}
        </dl>

        <h3 class="does__sub">What you can bring</h3>
        <dl class="does__grid">
          {WHAT_IT_DOES[cat].bring.map((item) => (
            <div class="tile does__tile">
              <dt class="does__what">{item.what}</dt>
              <dd class="does__how">{item.quip}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))
  }
</section>

<style>
  .does__mode {
    margin-top: 1.25rem;
    color: var(--ink-2);
  }
  .does__mode-name {
    display: inline-block;
    margin-left: 0.25rem;
    padding: 0.25rem 0.875rem;
    border-radius: var(--r-pill);
    background: var(--accent-soft);
    color: var(--ink);
    font-weight: 600;
  }

  .does {
    margin-top: 2.5rem;
  }

  /* The promise: the one big tile, in the tab's colour. */
  .does__promise {
    padding: clamp(1.75rem, 1rem + 3vw, 3rem);
    border-radius: var(--r-tile);
    background: var(--accent-soft);
  }
  .does__promise :global(.line) {
    max-width: 38rem;
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .does__sub {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink-2);
  }

  .does__grid {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 48rem) {
    .does__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .does__what {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .does__how {
    margin-top: 0.5rem;
    color: var(--ink-2);
  }
</style>
