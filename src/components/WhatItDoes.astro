---
/**
 * What the chosen category does, specifically: the promise, the four
 * things it does, and what you can bring to it. Replaces "Two ways to get
 * argued with" now that the tabs above make that choice. The heading is
 * shared (so the section keeps one name); only the word in it changes.
 */
import UserLine from './UserLine.astro';
import ProductLine from './ProductLine.astro';
import { CATEGORIES, CATEGORY, WHAT_IT_DOES } from '../data/categories';
import { SECTIONS } from '../config';
---

<section id={SECTIONS.whatItDoes} aria-labelledby="does-heading" class="section container-page">
  <div class="split">
    <div class="does__head">
      <h2 id="does-heading" class="split__head">
        What it does for your{' '}
        {CATEGORIES.map((cat) => <span data-cat={cat}>{CATEGORY[cat].noun}</span>)}
      </h2>
      {
        CATEGORIES.map((cat) => (
          <div class="does__mode" data-cat={cat}>
            <p class="does__mode-label">The mode you’d pick</p>
            <UserLine size="lg" speaker={false}>
              {CATEGORY[cat].mode}
            </UserLine>
          </div>
        ))
      }
    </div>

    {
      CATEGORIES.map((cat) => (
        <div class="split__body does" data-cat={cat}>
          <ProductLine size="lg">{WHAT_IT_DOES[cat].promise}</ProductLine>

          <h3 class="does__sub">What it does, specifically</h3>
          <dl class="does__list">
            {WHAT_IT_DOES[cat].does.map((item) => (
              <div class="does__row">
                <dt class="does__what">{item.what}</dt>
                <dd class="does__how">{item.how}</dd>
              </div>
            ))}
          </dl>

          <h3 class="does__sub">What you can bring</h3>
          <dl class="does__list">
            {WHAT_IT_DOES[cat].bring.map((item) => (
              <div class="does__row">
                <dt class="does__bring">{item.what}</dt>
                <dd class="does__quip">{item.quip}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))
    }
  </div>
</section>

<style>
  .does__mode {
    margin-top: 1.75rem;
  }
  .does__mode-label {
    margin-bottom: 0.375rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .does__sub {
    margin-top: 2.75rem;
    font-family: var(--font-user);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0;
  }

  .does__list {
    margin-top: 0.75rem;
    border-top: 1px solid var(--rule);
  }
  .does__row {
    display: grid;
    gap: 0.25rem;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--rule);
  }

  /* What it does is ours to say: product voice for the name. */
  .does__what {
    font-family: var(--font-product);
    font-size: var(--step-1);
    font-weight: 540;
    line-height: 1.3;
  }
  .does__how {
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  /* What you bring is in your voice; our one-liner back is in ours. */
  .does__bring {
    font-weight: 600;
  }
  .does__quip {
    font-family: var(--font-product);
    font-size: var(--step-1);
    line-height: 1.4;
    letter-spacing: 0.005em;
  }

  @media (min-width: 48rem) {
    .does__row {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: baseline;
      column-gap: 2rem;
    }
    .does__what {
      font-size: calc(var(--step-0) * 1.12);
    }
  }
</style>
