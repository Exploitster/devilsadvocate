---
/**
 * A static phone screen for illustrative mockups. It holds markup only:
 * nothing inside it is a working control.
 */
interface Props {
  /** Describes the mockup for assistive tech, e.g. "Mockup: step 3 in idea mode". */
  label: string;
  /** App bar title. */
  title?: string;
  /** Small line under the title, e.g. the mode. */
  subtitle?: string;
  /** Visible caption under the frame. */
  caption?: string;
  class?: string;
}

const { label, title = 'Devils Advocate', subtitle, caption, class: className } = Astro.props;
// A conditional `slot="bottom"` still registers the slot, so check that it
// actually rendered something.
const bottom = Astro.slots.has('bottom') ? (await Astro.slots.render('bottom')).trim() : '';
---

<figure class:list={['phone', className]} aria-label={label}>
  <div class="phone__bezel">
    <div class="phone__screen">
      <div class="phone__bar">
        <p class="phone__title">{title}</p>
        {subtitle && <p class="phone__subtitle">{subtitle}</p>}
      </div>
      <div class="phone__body">
        <slot />
      </div>
      {
        bottom && (
          <div class="phone__bottom">
            <Fragment set:html={bottom} />
          </div>
        )
      }
    </div>
  </div>
  {caption && <figcaption class="phone__caption">{caption}</figcaption>}
</figure>

<style>
  .phone {
    width: min(100%, 21rem);
    margin: 0;
  }

  /* A plain rounded device: no notch or buttons, nothing brand-specific. */
  .phone__bezel {
    padding: 0.5rem;
    border-radius: 2.75rem;
    background: var(--frame);
    box-shadow: var(--shadow-lift);
  }

  .phone__screen {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 34rem;
    overflow: hidden;
    border-radius: 2.25rem;
    background: var(--surface);
    color: var(--ink);
  }

  .phone__bar {
    padding: 1.25rem 1.125rem 0.75rem;
    text-align: center;
    background: var(--glass);
    box-shadow: inset 0 -1px 0 var(--line);
  }

  .phone__title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .phone__subtitle {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .phone__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1rem 0.875rem 1.25rem;
  }

  .phone__bottom {
    padding: 0.75rem 1rem 1.125rem;
    box-shadow: inset 0 1px 0 var(--line);
  }

  .phone__caption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
</style>
