---
/**
 * What the phone shows at one step of "How it works", for one category.
 * Static markup, never a working control. Elements marked `a` animate in,
 * one after another (--i sets the order), when the step becomes active;
 * see the story styles in HowItWorks.astro.
 */
import UserLine from './UserLine.astro';
import ProductLine from './ProductLine.astro';
import Receipt from './Receipt.astro';
import { CATEGORIES, CATEGORY, type Category } from '../data/categories';
import { EXAMPLES } from '../data/journey';

interface Props {
  step: number; // 1-7
  category: Category;
}

const { step, category } = Astro.props;
const ex = EXAMPLES[category];
const i = (n: number) => `--i:${n}`;
---

<div class="scr bubbles" data-step-screen={step}>
  {
    step === 1 && (
      <div class="modes">
        {CATEGORIES.map((c, n) => (
          <div class:list={['mode-option a', { 'is-chosen': c === category }]} style={i(n)}>
            <span>{CATEGORY[c].mode}</span>
            {c === category && (
              <svg class="mode-option__tick" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                <circle cx="10" cy="10" r="10" fill="currentColor" />
                <path d="M5.8 10.4l2.7 2.7 5.7-6" fill="none" stroke="var(--surface)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {c === category && <span class="sr-only-text">(chosen)</span>}
          </div>
        ))}
      </div>
    )
  }

  {
    step === 2 && (
      <>
        <p class="hint a" style={i(0)}>
          Type it like you’d text a friend.
        </p>
        <div class="composer-wrap">
          <div class="composer a" style={i(1)}>
            <p class="composer__text">
              <span class="sr-only-text">{ex.opening}</span>
              <span aria-hidden="true" data-type>
                {ex.opening}
              </span>
              <span class="composer__caret" aria-hidden="true" />
            </p>
            <span class="composer__send" aria-hidden="true">
              Send
            </span>
          </div>
        </div>
      </>
    )
  }

  {
    step === 3 && (
      <>
        <UserLine size="sm" class="a" style={i(0)}>
          {ex.opening}
        </UserLine>
        {ex.questions.map((q, n) => (
          <ProductLine size="sm" class="a" style={i(n + 1)}>
            {q}
          </ProductLine>
        ))}
      </>
    )
  }

  {
    step === 4 && (
      <>
        <UserLine size="sm" class="a" style={i(0)}>
          {ex.opening}
        </UserLine>
        <ProductLine size="sm" bodyAs="div" class="a" style={i(1)}>
          {ex.realQuestion.map((part, n) => (
            <p class="named a" style={i(n + 2)}>
              <strong class="lead">{part.lead}</strong> {part.text}
            </p>
          ))}
        </ProductLine>
      </>
    )
  }

  {
    step === 5 && (
      <>
        <p class="ui-label a" style={i(0)}>
          The case for you
        </p>
        <ProductLine size="sm" class="a" style={i(1)}>
          {ex.caseFor}
        </ProductLine>
        <p class="ui-label ui-label--gap a" style={i(2)}>
          The other side
        </p>
        <ProductLine size="sm" bodyAs="div" class="a" style={i(2)}>
          <ul class="receipts" role="list">
            {ex.receipts.map((r, n) => (
              <li class="a" style={i(n + 3)}>
                <Receipt>{r.source}</Receipt>
                <p>{r.point}</p>
              </li>
            ))}
          </ul>
        </ProductLine>
        <p class="note a" style={i(ex.receipts.length + 3)}>
          {ex.otherSideNote}
        </p>
      </>
    )
  }

  {
    step === 6 && (
      <>
        <UserLine size="sm" class="a" style={i(0)}>
          {ex.pushback}
        </UserLine>
        <div class="reply-slot">
          <p class="dots" aria-hidden="true">
            <span />
            <span />
            <span />
          </p>
          <ProductLine size="sm" class="a" style={i(8)}>
            {ex.reply}
          </ProductLine>
        </div>
      </>
    )
  }

  {
    step === 7 && (
      <div class="mini-card plain a" style={i(0)}>
        <p class="mini-card__title">Hand-back card</p>
        <div class="mini-card__part a" style={i(1)}>
          <p class="ui-label">Your position</p>
          <UserLine size="sm" speaker={false}>
            {ex.opening}
          </UserLine>
        </div>
        <div class="mini-card__part a" style={i(2)}>
          <p class="ui-label">Toughest counterpoints</p>
          <ul class="mini-card__chips" role="list">
            {ex.card.counterpoints.map((c) => (
              <li>
                <Receipt>{c}</Receipt>
              </li>
            ))}
          </ul>
        </div>
        <div class="mini-card__part a" style={i(3)}>
          <p class="ui-label">Cheapest test this month</p>
          <p class="mini-card__test">{ex.card.test}</p>
        </div>
        <p class="mini-card__foot a" style={i(4)}>
          Your call. Always.
        </p>
      </div>
    )
  }
</div>

<style>
  .scr {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.625rem;
    font-size: 0.9375rem;
  }

  .ui-label {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .ui-label--gap {
    margin-top: 0.5rem;
  }

  .note,
  .hint {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .hint {
    text-align: center;
  }

  .lead {
    font-weight: 600;
  }
  /* The named question gets an accent underline, drawn in. */
  .named .lead {
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / var(--draw, 100%) 2px no-repeat;
  }
  .named + .named {
    margin-top: 0.375rem;
  }

  /* Step 1: two options, like a settings list. */
  .modes {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .mode-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.625rem 1rem;
    border-radius: 0.875rem;
    background: var(--surface-2);
    font-weight: 600;
    line-height: 1.3;
  }
  .mode-option.is-chosen {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1.5px var(--accent);
    color: var(--accent);
  }
  .mode-option.is-chosen span {
    color: var(--ink);
  }

  /* Step 2: a picture of a text box with the message typed in. Nothing
     here is an input or a button. It sits at the bottom of the screen,
     edge to edge, like a real message box. */
  .composer-wrap {
    margin: auto -0.875rem -1.25rem;
    padding: 0.75rem 0.875rem 1.125rem;
    box-shadow: inset 0 1px 0 var(--line);
  }
  .composer {
    display: grid;
    gap: 0.5rem;
    padding: 0.625rem 0.625rem 0.625rem 0.875rem;
    border-radius: 1.25rem;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--control);
  }
  .composer__text {
    min-height: 4.35em;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .composer__caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: -0.2em;
    border-radius: 1px;
    background: var(--accent);
  }
  .composer__send {
    justify-self: end;
    padding: 0.3rem 0.875rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  /* Step 5 */
  .receipts {
    display: grid;
    gap: 0.75rem;
  }
  .receipts p {
    margin-top: 0.25rem;
  }

  /* Step 6: the product thinking, then its reply. */
  .dots {
    gap: 0.3rem;
    align-items: center;
    align-self: flex-start;
    height: 2.1em;
    padding: 0 0.85em;
    border-radius: 1.15em;
    border-bottom-left-radius: 0.35em;
    background: var(--bubble-product-bg);
  }
  .dots span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ink-2);
    opacity: 0.5;
  }

  /* Step 7: the card, grouped like an inset list. */
  .mini-card {
    overflow: hidden;
    border-radius: 1rem;
    background: var(--surface-2);
  }
  .mini-card__title {
    padding: 0.875rem 1rem 0.25rem;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .mini-card__part {
    display: grid;
    gap: 0.375rem;
    padding: 0.75rem 1rem;
  }
  .mini-card__part + .mini-card__part {
    box-shadow: inset 0 1px 0 var(--line);
  }
  .mini-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .mini-card__test {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.45;
  }
  .mini-card__foot {
    padding: 0.625rem 1rem 0.875rem;
    box-shadow: inset 0 1px 0 var(--line);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    text-align: right;
  }
</style>
