---
import { NAV_LINKS, SECTIONS, SITE, WAITLIST_ON, sectionHref } from '../config';
---

<header class="site-header sticky top-0 z-40">
  <nav aria-label="Main" class="container-page flex h-(--header-h) items-center gap-2 sm:gap-3">
    <a href={sectionHref(SECTIONS.hero)} class="logo mr-auto whitespace-nowrap rounded-sm text-[1.0625rem] sm:text-[1.125rem] font-semibold tracking-[-0.02em] no-underline">
      {SITE.name}
    </a>

    <ul class="hidden items-center gap-1 lg:flex" role="list">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} class="nav-link inline-flex min-h-11 items-center whitespace-nowrap rounded-sm px-3 text-[0.9375rem] no-underline">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    {
      WAITLIST_ON && (
        <a href={sectionHref(SECTIONS.waitlist)} class="btn-primary header-cta !min-h-10 !px-4 !text-[0.875rem] lg:ml-2">
          Join the waitlist
        </a>
      )
    }

    <button
      type="button"
      class="menu-toggle inline-flex size-11 shrink-0 items-center justify-center rounded-pill lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menu"
      hidden
    >
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
        <path class="bar bar--top" d="M3 6h14" />
        <path class="bar bar--bottom" d="M3 14h14" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="mobile-menu lg:hidden">
    <ul class="container-page flex flex-col py-2" role="list">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} class="menu-link flex min-h-12 items-center text-step-1 font-semibold no-underline">
              {link.label}
            </a>
          </li>
        ))
      }
      {
        WAITLIST_ON && (
          <li class="py-4">
            <a href={sectionHref(SECTIONS.waitlist)} class="btn-primary w-full">
              Join the waitlist
            </a>
          </li>
        )
      }
    </ul>
  </div>
</header>

<style>
  /* Glass: the page shows through, softly blurred, over a hairline. */
  .site-header {
    background: var(--glass);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: inset 0 -1px 0 var(--line);
  }

  .nav-link {
    color: var(--ink-2);
    transition: color 200ms ease;
  }
  .nav-link:hover {
    color: var(--ink);
  }

  .menu-toggle {
    color: var(--ink);
  }
  .menu-toggle:hover {
    background: var(--surface-2);
  }

  /* Two bars become a cross while the menu is open. */
  .bar {
    transform-origin: 10px 10px;
    transition: transform 160ms ease;
  }
  .menu-toggle[aria-expanded='true'] .bar--top {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .bar--bottom {
    transform: translateY(-4px) rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .bar {
      transition: none;
    }
  }

  /* The header button needs room next to the logo and the menu button.
     Below 370px it lives inside the menu instead. */
  .header-cta {
    display: none;
  }
  @media (min-width: 23.125rem) {
    .header-cta {
      display: inline-flex;
    }
  }

  /* Without JavaScript the links stay in view as a plain list. With it,
     the list becomes a dropdown under the header. */
  li + li > .menu-link {
    box-shadow: inset 0 1px 0 var(--line);
  }
  :global(.js) .mobile-menu {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    display: none;
    background: var(--glass);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow:
      inset 0 -1px 0 var(--line),
      0 12px 24px rgb(0 0 0 / 0.06);
  }
  :global(.js) .mobile-menu[data-open] {
    display: block;
  }
  @media (min-width: 64rem) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.hidden = false;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('data-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    matchMedia('(min-width: 64rem)').addEventListener('change', (query) => {
      if (query.matches) setOpen(false);
    });
  }
</script>
