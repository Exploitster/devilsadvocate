---
/**
 * One phone for one step, used by the plain list version of "How it
 * works" (without JavaScript, with reduced motion, and on short screens).
 * Nothing in here is a working control.
 */
import PhoneFrame from './PhoneFrame.astro';
import StepScreen from './StepScreen.astro';
import { CATEGORY, type Category } from '../data/categories';
import { STEPS } from '../data/journey';

interface Props {
  step: number; // 1-7
  category: Category;
}

const { step, category } = Astro.props;
const label = `Mockup of step ${step}, ${STEPS[step - 1]!.title.replace(/\.$/, '')}, ${CATEGORY[category].label.toLowerCase()} example`;
---

<PhoneFrame label={label} subtitle={step === 1 ? undefined : CATEGORY[category].mode}>
  <div class="screen" data-screen>
    <StepScreen step={step} category={category} />
  </div>
</PhoneFrame>
