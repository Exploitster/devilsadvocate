---
/**
 * A static mock of the hand-back card, filled with the chosen category's
 * example (see HAND_BACK in src/data/categories.ts). The one "card" on the
 * page: it should look like something you'd screenshot and send a friend.
 */
import UserLine from './UserLine.astro';
import Receipt from './Receipt.astro';
import { CATEGORY, HAND_BACK, type Category } from '../data/categories';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const card = HAND_BACK[category];
const titleId = `hbc-title-${category}`;
---

<article class="hbc" aria-labelledby={titleId}>
  <header class="hbc__head">
    <p id={titleId} class="hbc__title">Hand-back card</p>
    <p class="hbc__mode">{CATEGORY[category].mode}</p>
  </header>

  <div class="hbc__part">
    <h3 class="hbc__label">Your position</h3>
    <UserLine size="sm" speaker={false} class="hbc__position">
      {card.position}
    </UserLine>
  </div>

  <div class="hbc__part">
    <h3 class="hbc__label">Toughest counterpoints</h3>
    <ol class="hbc__counter" role="list">
      {
        card.counterpoints.map((c) => (
          <li>
            <p class="hbc__point">{c.point}</p>
            <Receipt>{c.source}</Receipt>
          </li>
        ))
      }
    </ol>
    <p class="hbc__note">{card.note}</p>
  </div>

  <div class="hbc__part">
    <h3 class="hbc__label">What’s genuinely strong</h3>
    <p class="hbc__prose">{card.strong}</p>
  </div>

  <div class="hbc__part">
    <h3 class="hbc__label">Open questions only you can answer</h3>
    <ul class="hbc__questions" role="list">
      {card.questions.map((q) => <li>{q}</li>)}
    </ul>
  </div>

  <div class="hbc__part">
    <h3 class="hbc__label">Cheapest test this month</h3>
    <p class="hbc__prose">{card.test}</p>
  </div>

  <footer class="hbc__foot">
    <span class="hbc__brand">Devils Advocate</span>
    <span>Your call. Always.</span>
  </footer>
</article>

<style>
  /* A white tile that floats a little: the one thing on the page you'd
     screenshot and send a friend. */
  .hbc {
    --hbc-pad: clamp(1.25rem, 0.9rem + 1.4vw, 1.75rem);
    position: relative;
    width: 100%;
    max-width: 30rem;
    overflow: hidden;
    border-radius: var(--r-tile);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-lift);
  }

  .hbc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 1.375rem var(--hbc-pad) 0.5rem;
  }

  .hbc__title {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hbc__mode {
    padding: 0.25rem 0.75rem;
    border-radius: var(--r-pill);
    background: var(--accent-soft);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .hbc__part {
    padding: 1rem var(--hbc-pad);
  }
  .hbc__part + .hbc__part {
    box-shadow: inset 0 1px 0 var(--line);
  }

  .hbc__label {
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--ink-2);
  }

  .hbc :global(.hbc__position) {
    font-size: 1.0625rem !important;
    font-weight: 600;
  }

  .hbc__counter {
    display: grid;
    gap: 0.875rem;
    counter-reset: point;
  }
  .hbc__counter li {
    position: relative;
    padding-left: 2.25rem;
    counter-increment: point;
  }
  .hbc__counter li::before {
    content: counter(point);
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
  }

  .hbc__point,
  .hbc__prose,
  .hbc__questions {
    font-size: 1rem;
    line-height: 1.45;
  }
  .hbc__point {
    margin-bottom: 0.3rem;
  }

  .hbc__note {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .hbc__questions {
    display: grid;
    gap: 0.375rem;
  }
  .hbc__questions li {
    position: relative;
    padding-left: 2.25rem;
  }
  .hbc__questions li::before {
    content: '?';
    position: absolute;
    left: 0.45rem;
    font-weight: 700;
    color: var(--accent);
  }

  .hbc__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.875rem var(--hbc-pad) 1.125rem;
    box-shadow: inset 0 1px 0 var(--line);
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .hbc__brand {
    font-weight: 600;
    color: var(--ink);
  }
</style>
