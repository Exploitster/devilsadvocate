---
import { CATEGORIES, WHY } from '../data/categories';
import { SECTIONS } from '../config';
---

<section id={SECTIONS.why} aria-labelledby="why-heading" class="section container-page">
  <div class="split">
    <h2 id="why-heading" class="split__head">The people who love you are terrible at this.</h2>

    {
      CATEGORIES.map((cat) => (
        <div class="split__body" data-cat={cat}>
          {/* Everyone else's opinion, one per line and muted: none of them
              get a speech mark, because none of them bring sources. */}
          <p class="why__others">
            {WHY[cat].others.map((line) => (
              <span>{line}</span>
            ))}
            <span class="why__verdict">Nobody shows their sources.</span>
          </p>

          <p class="why__body">{WHY[cat].body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .why__others {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--ink-muted);
  }

  .why__verdict {
    margin-top: 0.75rem;
    font-family: var(--font-product);
    font-size: var(--step-2);
    font-weight: 540;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .why__body {
    margin-top: 2rem;
    max-width: var(--measure);
  }
</style>
