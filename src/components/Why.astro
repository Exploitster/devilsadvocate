---
import { CATEGORIES, WHY } from '../data/categories';
import { SECTIONS } from '../config';
---

<section id={SECTIONS.why} aria-labelledby="why-heading" class="section band container-page">
  <div class="section-head">
    <h2 id="why-heading">The people who love you are terrible at this.</h2>
  </div>

  {
    CATEGORIES.map((cat) => (
      <div class="why" data-cat={cat}>
        {/* Everyone else's opinion, as quiet grey chips: none of them
            bring sources. */}
        <ul class="why__others" role="list">
          {WHY[cat].others.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
        <p class="why__verdict">Nobody shows their sources.</p>
        <p class="why__body">{WHY[cat].body}</p>
      </div>
    ))
  }
</section>

<style>
  .why {
    max-width: 40rem;
    margin: 2.5rem auto 0;
    text-align: center;
  }

  .why__others {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .why__others li {
    padding: 0.5rem 1rem;
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .why__verdict {
    margin-top: 2rem;
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .why__body {
    margin-top: 1rem;
    color: var(--ink-2);
  }
</style>
