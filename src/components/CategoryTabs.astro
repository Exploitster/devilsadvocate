---
/**
 * The Philosophy / Startup capsule under the hero: a floating, centered
 * segmented control. It's a real radio group, so it works with the
 * keyboard (arrow keys) and without JavaScript (global.css switches the
 * content with :has()). categories.ts adds the rest: keeping your place
 * when you switch, the slide, the notice, the URL (?for=), and the
 * "headroom" behaviour (headroom.ts): once you've scrolled past it, it
 * hides while you scroll down and comes back under the header when you
 * scroll up.
 *
 * <html data-category> (set before first paint in Base.astro) is the
 * source of truth; the radios follow it.
 */
import { CATEGORIES, CATEGORY, DEFAULT_CATEGORY, type Category } from '../data/categories';

// Line icons, 24px grid, drawn with the text colour.
const ICON: Record<Category, string> = {
  // A column-fronted building: thinking done in public for 2,000 years.
  philosophy:
    '<path d="M3.5 9h17M4.5 9 12 4l7.5 5M6.5 12v6M10 12v6M14 12v6M17.5 12v6M4 21h16M5 18.5h14"/>',
  // A lightbulb: an idea.
  startup:
    '<path d="M9.5 17.5h5M10.5 20.5h3M12 3.5a5.75 5.75 0 0 0-3.45 10.35c.6.46.95 1.14.95 1.9v.25h5v-.25c0-.76.35-1.44.95-1.9A5.75 5.75 0 0 0 12 3.5Z"/>',
};
const icon = (cat: Category, size: number) =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[cat]}</svg>`;
---

<div class="cats-lead container-page">
  <p id="cats-label" class="cats-lead__text">What are you bringing? The rest of the page changes to match.</p>
</div>

{/* Where the capsule sits in the page: headroom.ts watches it to tell
    "in its place" from "stuck under the header". */}
<div class="cats-sentinel" data-cats-sentinel aria-hidden="true"></div>

<div class="cats" data-cats data-headroom="in-flow">
  <div class="capsule">
    <div class="capsule__set" role="radiogroup" aria-labelledby="cats-label">
      <span class="capsule__thumb" aria-hidden="true"></span>
      {
        CATEGORIES.map((cat) => (
          <label class="capsule__seg">
            <input
              type="radio"
              name="category"
              id={`cat-${cat}`}
              value={cat}
              checked={cat === DEFAULT_CATEGORY}
              aria-describedby={`cat-${cat}-card`}
            />
            <Fragment set:html={icon(cat, 18)} />
            <span>{CATEGORY[cat].label}</span>
          </label>
        ))
      }
    </div>
  </div>
</div>

<script is:inline>
  // Before first paint: check the tab named by <html data-category> (set in
  // <head> from ?for=), so the capsule matches the page. Until
  // categories.ts takes over, a change still switches the page.
  (function () {
    var root = document.documentElement;
    var input = document.getElementById('cat-' + root.getAttribute('data-category'));
    if (input) input.checked = true;
    document.addEventListener('change', function (e) {
      var t = e.target;
      if (t && t.name === 'category' && !root.hasAttribute('data-cats-live')) root.setAttribute('data-category', t.value);
    });
  })();
</script>

{/* The first thing that changes when you switch: what this tab is for. */}
<div class="cats-cards container-page">
  {
    CATEGORIES.map((cat) => (
      <div class="cats-card" data-cat={cat} data-cats-card>
        <span class="cats-card__icon">
          <Fragment set:html={icon(cat, 22)} />
        </span>
        <p id={`cat-${cat}-card`} class="cats-card__text">
          <span class="cats-card__mode">{CATEGORY[cat].mode}</span>
          <span class="cats-card__line">{CATEGORY[cat].card}</span>
        </p>
      </div>
    ))
  }
</div>

{/* Says what changed after a switch, when the card isn't on screen. Empty
    from the start, so screen readers treat it as a live region. */}
<p class="cats-toast" role="status" data-cats-toast></p>

<script>
  import { initCategories } from '../scripts/categories';
  initCategories();
</script>

<style>
  .cats-lead {
    margin-top: calc(var(--section-gap) * -0.2);
    text-align: center;
  }
  .cats-lead__text {
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--ink-2);
  }

  .cats-sentinel {
    height: 0;
  }

  /* The wrapper sticks under the header and spans the width; only the
     capsule inside takes clicks, so content under the empty sides stays
     usable. */
  .cats {
    position: sticky;
    top: calc(var(--header-h) + 0.5rem);
    z-index: 30;
    display: flex;
    justify-content: center;
    margin-top: 1rem;
    pointer-events: none;
  }

  .capsule {
    pointer-events: auto;
    padding: 4px;
    border-radius: var(--r-pill);
    background: var(--glass);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow:
      var(--shadow-float),
      inset 0 0 0 1px var(--line);
    transition:
      transform 300ms var(--ease),
      opacity 240ms var(--ease);
    will-change: transform;
  }

  /* Headroom: hidden above the header while you scroll down. */
  .cats[data-headroom='hidden'] .capsule {
    transform: translateY(calc(-100% - var(--header-h)));
    opacity: 0;
    pointer-events: none;
  }
  .cats[data-instant] .capsule {
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .capsule {
      transition: none;
    }
  }

  .capsule__set {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  /* The sliding thumb: the accent's soft tint with an accent ring, so the
     chosen side reads at a glance (and at 3:1 or more). */
  .capsule__thumb {
    position: absolute;
    inset: 0 50% 0 0;
    border-radius: var(--r-pill);
    background: var(--capsule-thumb);
    box-shadow:
      0 1px 3px rgb(0 0 0 / 0.12),
      inset 0 0 0 1.5px var(--accent);
    transition:
      transform 380ms var(--ease-spring),
      background-color 250ms ease;
  }
  .capsule__set:has(#cat-startup:checked) .capsule__thumb {
    transform: translateX(100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .capsule__thumb {
      transition: none;
    }
  }

  .capsule__seg {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 9.25rem;
    height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: var(--r-pill);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    white-space: nowrap;
    cursor: pointer;
    transition: color 200ms ease;
  }
  .capsule__seg:has(input:checked) {
    color: var(--accent);
  }
  .capsule__seg:has(input:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .capsule__seg input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    /* The page keeps room at the top for the header and this band
       (scroll-padding). Without this, focusing a tab while it's stuck
       there counts as "hidden under the bar" and scrolls the page. */
    scroll-margin-top: calc(-1 * (var(--header-h) + var(--tabs-h) + 1rem));
  }

  /* Category card */
  .cats-cards {
    display: flex;
    justify-content: center;
    margin-top: 1.25rem;
  }
  .cats-card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    max-width: 30rem;
    padding: 0.875rem 1.25rem 0.875rem 0.875rem;
    border-radius: var(--r-card);
    background: var(--accent-soft);
  }
  .cats-card__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--surface);
    color: var(--accent);
  }
  .cats-card__text {
    display: grid;
    gap: 0.125rem;
    line-height: 1.35;
  }
  .cats-card__mode {
    font-weight: 600;
  }
  .cats-card__line {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  /* The notice: opaque (no glass), under the capsule's pinned spot. */
  .cats-toast {
    position: fixed;
    top: calc(var(--header-h) + var(--tabs-h));
    left: 50%;
    z-index: 29;
    width: max-content;
    max-width: calc(100vw - 2 * var(--gutter));
    padding: 0.625rem 1.125rem;
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: var(--shadow-float);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
    opacity: 0;
    translate: -50% -0.5rem;
    pointer-events: none;
    transition:
      opacity 240ms ease,
      translate 240ms var(--ease);
  }
  .cats-toast[data-show] {
    opacity: 1;
    translate: -50% 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .cats-toast {
      transition: none;
    }
  }
</style>
