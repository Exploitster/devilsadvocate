---
import HandBackCard from './HandBackCard.astro';
import { SECTIONS } from '../config';
import { CATEGORIES } from '../data/categories';
---

<section id={SECTIONS.whatYouGet} aria-labelledby="get-heading" class="section container-page">
  <div class="get">
    <div class="get__copy">
      <h2 id="get-heading">The <span class="whitespace-nowrap">hand-back</span> card</h2>
      <p class="get__intro section-lead">Every session ends with one card that’s yours to keep:</p>
      <ul class="get__list list-check" role="list">
        <li>Your position, in one line</li>
        <li>The 3 toughest counterpoints, each with its source</li>
        <li>What’s genuinely strong in your case</li>
        <li>The open questions only you can answer</li>
        <li>The cheapest test you can run this month</li>
      </ul>
      <p class="get__kicker">No verdict. We don’t do verdicts. We do homework.</p>
    </div>

    {
      CATEGORIES.map((cat) => (
        <div class="get__card" data-cat={cat}>
          <HandBackCard category={cat} />
        </div>
      ))
    }
  </div>
</section>

<style>
  .get {
    display: grid;
    gap: 3rem;
  }

  .get__intro {
    max-width: var(--measure);
  }

  .get__list {
    margin-top: 1.5rem;
  }

  /* The product gets the last word. */
  .get__kicker {
    margin-top: 2rem;
    max-width: 24ch;
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  @media (min-width: 64rem) {
    .get {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
    }
    .get__card {
      display: flex;
      justify-content: center;
    }
  }
</style>
