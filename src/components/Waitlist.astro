---
/**
 * The waitlist. A form on a white tile; the reply after joining is the
 * product's, as a short chat in a pop-up. Signups go
 * straight from the browser into the Supabase `waitlist` table, which the
 * public can add to but not read. See supabase/waitlist.sql. The values
 * sent for role and interests are the labels, as the table's checks expect.
 */
import ProductLine from './ProductLine.astro';
import UserLine from './UserLine.astro';
import { SECTIONS, path } from '../config';

const ROLES = ['MBA student', 'First-time founder', 'Working professional', 'Just curious'];
const INTERESTS = ['A startup idea', 'A life decision', 'A work proposal', 'A belief I want to test'];

// After joining without typing an idea: one line for the first thing they
// said they'd bring.
const INTEREST_REPLIES = [
  { interest: 'A startup idea', line: 'Bring the startup idea. We’re already dusting off the graveyard files.' },
  { interest: 'A life decision', line: 'Bring the big decision. Aristotle has been warned.' },
  { interest: 'A work proposal', line: 'Bring the proposal. We’ll find the holes before your boss does.' },
  { interest: 'A belief I want to test', line: 'Bring the belief. Seneca has waited nearly 2,000 years for this.' },
];

const check = `<svg class="chip__check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section id={SECTIONS.waitlist} aria-labelledby="waitlist-heading" class="section band container-page">
  <div>
    <div class="section-head">
      <h2 id="waitlist-heading">Got an idea you’re completely sure about? Perfect.</h2>
      <p class="section-lead">Join the waitlist. We’ll argue with you on December 1.</p>
    </div>

    <div class="waitlist__tile">
      <form class="waitlist" data-waitlist novalidate>
        <div class="field">
          <label for="wl-email" class="field__label">Email</label>
          <input
            id="wl-email"
            class="field__input"
            type="email"
            name="email"
            autocomplete="email"
            inputmode="email"
            required
            aria-describedby="wl-email-error"
          />
          <p id="wl-email-error" class="field__error" data-email-error hidden>
            That email looks off. Check for typos and try again.
          </p>
        </div>

        <div class="field">
          <label for="wl-name" class="field__label">First name <span class="field__opt">(optional)</span></label>
          <input id="wl-name" class="field__input" type="text" name="first_name" autocomplete="given-name" maxlength="80" />
        </div>

        <fieldset class="field">
          <legend class="field__label">I am a <span class="field__opt">(pick one)</span></legend>
          <div class="chips">
            {
              ROLES.map((role) => (
                <label class="chip">
                  <input type="radio" name="role" value={role} />
                  <Fragment set:html={check} />
                  <span>{role}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="field">
          <legend class="field__label">What would you bring first? <span class="field__opt">(pick any)</span></legend>
          <div class="chips">
            {
              INTERESTS.map((interest) => (
                <label class="chip">
                  <input type="checkbox" name="interests" value={interest} />
                  <Fragment set:html={check} />
                  <span>{interest}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="field">
          <label for="wl-challenge" class="field__label">
            The idea or decision you’d bring <span class="field__opt">(optional)</span>
          </label>
          <input
            id="wl-challenge"
            class="field__input"
            type="text"
            name="first_challenge"
            maxlength="280"
            placeholder="e.g. I’m skipping placements to start a pet-food brand"
            data-placeholder-startup="e.g. A pet-food brand for city apartments"
            data-placeholder-philosophy="e.g. Should I take the job in another city?"
          />
        </div>

        <div class="field">
          <div class="consent">
            <label class="consent__label">
              <input
                type="checkbox"
                name="consent"
                class="consent__box"
                required
                aria-describedby="wl-consent-error"
                data-consent
              />
              <span>Email me about the Devils Advocate beta. Unsubscribe anytime.</span>
            </label>
            <a class="link-quiet consent__privacy" href={path('/privacy/')}>Privacy</a>
          </div>
          <p id="wl-consent-error" class="field__error" data-consent-error hidden>
            Tick the box so we can email you about the beta.
          </p>
        </div>

        {/* Left empty by people, filled in by bots; a filled one is dropped. */}
        <div class="waitlist__trap" aria-hidden="true">
          <label>Leave this empty <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="waitlist__actions">
          <button type="submit" class="btn-primary" data-submit>Join the waitlist</button>
        </div>

        <p class="waitlist__status" role="status" aria-live="polite" data-status></p>

        <noscript>
          <p class="waitlist__status">Please enable JavaScript to join the waitlist.</p>
        </noscript>
      </form>

      {/* Takes the form's place once someone has joined. Focus lands here
          when the pop-up closes. */}
      <div class="waitlist__note" data-done-note tabindex="-1" hidden>
        <ProductLine size="lg" data-note-joined>You’re on the list<span data-note-name></span>. See you on December 1.</ProductLine>
        <ProductLine size="lg" data-note-already hidden>You’re already on the list.</ProductLine>
        <button type="button" class="link-quiet waitlist__reopen" data-done-reopen>Show the thank-you again</button>
      </div>

      {/* After joining, the product answers in a pop-up: a short exchange in
          the two voices, then a mini hand-back card, the thing every real
          session ends with. waitlist.ts fills in the name and echoes their
          idea (as text, never HTML). A repeat signup gets its own line
          instead. It closes with the button, Escape, or a tap outside. */}
      <dialog class="thanks-dialog" data-done aria-labelledby="thanks-joined-title" tabindex="-1">
        <div class="thanks-dialog__body bubbles">
          <div class="thanks" data-done-joined>
            <ProductLine size="lg" id="thanks-joined-title">You’re in<span data-thanks-name></span>. Welcome to the argument.</ProductLine>
            <ProductLine>
              We’ll email you before the beta opens on December 1. The waitlist gets in first, so you’ll be one of the first
              people we politely disagree with.
            </ProductLine>

            <div class="thanks__exchange" data-thanks-idea hidden>
              <UserLine><span data-thanks-idea-text></span></UserLine>
              <ProductLine>
                Noted. That’s the first thing we’ll argue about. Enjoy being completely sure of it until then.
              </ProductLine>
            </div>

            {
              INTEREST_REPLIES.map((reply) => (
                <ProductLine data-thanks-interest={reply.interest} hidden>
                  {reply.line}
                </ProductLine>
              ))
            }

            <article class="thanks__card plain" aria-labelledby="thanks-card-title">
              <p id="thanks-card-title" class="thanks__card-title">Your first hand-back card</p>
              <div class="thanks__part">
                <p class="thanks__label">Your position</p>
                <UserLine size="sm" speaker={false}>I’m on the waitlist.</UserLine>
              </div>
              <div class="thanks__part">
                <p class="thanks__label">Toughest counterpoint</p>
                <p class="thanks__text">None. It’s the one call we won’t argue with.</p>
              </div>
              <div class="thanks__part">
                <p class="thanks__label">Cheapest test before December 1</p>
                <p class="thanks__text">Doubt one thing you believed this morning.</p>
              </div>
              <p class="thanks__foot">Your call. Always.</p>
            </article>
          </div>
          <ProductLine size="lg" id="thanks-already-title" data-done-already hidden>
            You’re already on the list. Eager. We respect it.
          </ProductLine>
        </div>
        <div class="thanks-dialog__foot">
          <button type="button" class="btn-secondary thanks-dialog__close" data-done-close>Close</button>
        </div>
      </dialog>
    </div>
  </div>
</section>

<script>
  import { initWaitlist } from '../scripts/waitlist';
  initWaitlist();
</script>

<style>
  .waitlist__tile {
    max-width: 38rem;
    margin: 2.5rem auto 0;
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem);
    border-radius: var(--r-tile);
    background: var(--surface);
  }

  .waitlist {
    display: grid;
    gap: 1.5rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .field__label {
    padding: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .field__opt {
    font-weight: 400;
    color: var(--ink-2);
  }

  /* 17px or more, so iOS doesn't zoom into the field on focus. The
     border is the grey that still reads at 3:1. */
  .field__input {
    width: 100%;
    min-height: 3rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--control);
    border-radius: var(--r-control);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: max(1.0625rem, var(--step-0));
    transition: border-color 160ms ease;
  }
  .field__input:focus-visible {
    border-color: var(--accent);
    outline-offset: 0;
  }
  .field__input::placeholder {
    color: var(--ink-2);
    opacity: 1;
  }
  .field__input[aria-invalid='true'] {
    border-color: var(--danger);
    box-shadow: inset 0 0 0 1px var(--danger);
  }

  .field__error {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--danger);
  }

  /* Choices as pills: the tab's colour when picked, plus a tick, so the
     state never relies on colour alone. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--control);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.25;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease;
  }
  .chip input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .chip :global(.chip__check) {
    display: none;
    color: var(--accent);
  }
  .chip:hover {
    background: var(--surface-2);
  }
  .chip:has(input:checked) {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }
  .chip:has(input:checked) :global(.chip__check) {
    display: block;
  }
  .chip:has(input:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .waitlist__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .waitlist__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .waitlist__actions button {
    width: 100%;
    min-height: 3rem;
  }
  @media (min-width: 40rem) {
    .waitlist__actions button {
      width: auto;
    }
  }
  .waitlist__actions button[aria-busy='true'] {
    cursor: progress;
    opacity: 0.8;
  }

  /* Consent: a real checkbox (in the accent when ticked), its sentence,
     and the privacy link beside it. The whole label is the tap target. */
  .consent {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }
  .consent__label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding-top: 0.25rem;
    font-size: 0.9375rem;
    cursor: pointer;
  }
  .consent__box {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1em;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .consent__box[aria-invalid='true'] {
    outline: 2px solid var(--danger);
    outline-offset: 2px;
  }
  .consent__privacy {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    font-size: 0.9375rem;
  }

  .waitlist__status:empty {
    display: none;
  }
  .waitlist__status {
    font-weight: 500;
    color: var(--danger);
  }

  .waitlist__note {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
    outline: none;
  }
  .waitlist__note[hidden] {
    display: none;
  }
  .waitlist__note :global(.line) {
    font-weight: 600;
  }
  .waitlist__reopen {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  /* The pop-up. A sheet from the bottom edge on phones, where thumbs are;
     centered from 40rem. Its body scrolls under a footer that keeps Close
     in reach. */
  .thanks-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    max-height: calc(100dvh - 1.5rem);
    margin: auto 0 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    border-radius: var(--r-tile) var(--r-tile) 0 0;
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-float);
    outline: none;
  }
  .thanks-dialog::backdrop {
    background: rgb(0 0 0 / 0.4);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  /* The page is already dark here, so it needs more dimming to recede. */
  @media (prefers-color-scheme: dark) {
    .thanks-dialog::backdrop {
      background: rgb(0 0 0 / 0.65);
    }
  }
  .thanks-dialog__body {
    padding: 1.75rem var(--gutter) 1.5rem;
  }
  .thanks-dialog__foot {
    position: sticky;
    bottom: 0;
    display: flex;
    justify-content: flex-end;
    padding: 0.75rem var(--gutter) max(0.75rem, env(safe-area-inset-bottom));
    box-shadow: inset 0 1px 0 var(--line);
    background: var(--surface);
  }
  .thanks-dialog__close {
    width: 100%;
  }

  @media (min-width: 40rem) {
    .thanks-dialog {
      width: min(34rem, 100% - 3rem);
      max-height: calc(100dvh - 4rem);
      margin: auto;
      border-radius: var(--r-tile);
    }
    .thanks-dialog__body {
      padding: 2rem 2rem 1.5rem;
    }
    .thanks-dialog__foot {
      padding: 0.875rem 2rem;
    }
    .thanks-dialog__close {
      width: auto;
    }
  }

  /* Nothing behind the pop-up scrolls while it's open. */
  :global(html:has(dialog[data-done][open])) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .thanks-dialog[open] {
      animation: thanks-in 260ms var(--ease);
    }
    .thanks-dialog[open]::backdrop {
      animation: thanks-fade 220ms ease-out;
    }
  }
  @keyframes thanks-in {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.98);
    }
  }
  @keyframes thanks-fade {
    from {
      opacity: 0;
    }
  }

  /* The thank-you: a short chat, then a mini hand-back card. */
  .thanks {
    display: grid;
    gap: 0.5rem;
    font-size: 1rem;
  }
  .thanks :global(.line--lg) {
    font-size: 1.0625rem;
  }
  .thanks__exchange {
    display: grid;
    gap: 0.5rem;
  }
  .thanks__card {
    max-width: 26rem;
    margin-top: 1rem;
    overflow: hidden;
    border-radius: 1.125rem;
    background: var(--surface-2);
  }
  .thanks__card-title {
    padding: 1rem 1.125rem 0.25rem;
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .thanks__part {
    display: grid;
    gap: 0.375rem;
    padding: 0.75rem 1.125rem;
  }
  .thanks__part + .thanks__part {
    box-shadow: inset 0 1px 0 var(--line);
  }
  .thanks__label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .thanks__text {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.45;
  }
  .thanks__foot {
    padding: 0.625rem 1.125rem 0.875rem;
    box-shadow: inset 0 1px 0 var(--line);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    text-align: right;
  }
</style>
